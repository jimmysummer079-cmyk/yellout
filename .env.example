# Server
PORT=8787
DATABASE_PATH=./data/yellout.db
UPLOAD_DIR=./uploads
WEB_DIST=./apps/web/dist
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional: enable Gemini-backed moderation (graceful stub when empty)
# GEMINI_API_KEY=

# Rate limits (optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=120
# VENT_RATE_LIMIT_MAX=20
# REPLY_RATE_LIMIT_MAX=40

# Dev only — Vite proxy target
# VITE_API_PROXY=http://127.0.0.1:8787
