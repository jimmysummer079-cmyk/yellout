{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://yellout.onrender.com"
      }
    },
    "preview-android-apk": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "preview-ios-internal": {
      "extends": "preview",
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://yellout.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
